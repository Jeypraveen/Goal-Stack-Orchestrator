# ============================================
# Goal-Stack Orchestrator - Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# All services below have free tiers - no credit card required.

# --- Database ---
# Local SQLite database file path (created automatically)
DATABASE_URL=sqlite:///orchestrator.db

# --- Groq (Router LLM) ---
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your-key-here

# --- Google AI Studio (Gemini Flash - Agent LLM) ---
# Get from: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=your-google-api-key-here

# --- App Config ---
ENVIRONMENT=development
