# ============================================
# Goal-Stack Orchestrator — Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# All services below have free tiers — no credit card required.

# --- Supabase (Postgres) ---
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Direct Postgres connection string
# Get from: Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Groq (Router LLM) ---
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your-key-here

# --- Google AI Studio (Gemini Flash — Agent LLM) ---
# Get from: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=your-google-api-key-here

# --- App Config ---
ENVIRONMENT=development
